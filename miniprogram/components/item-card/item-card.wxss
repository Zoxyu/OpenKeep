/* 物品卡片：大圆角、轻阴影、左侧状态色边条 */
.item-card {
  display: flex;
  align-items: stretch;
  background: var(--c-card);
  border-radius: 24rpx;
  border: 1rpx solid var(--c-line);
  box-shadow: var(--c-shadow);
  padding: 24rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}
.item-card-hover { opacity: 0.9; transform: translateY(1rpx); }

.cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 18rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.cover-img { width: 100%; height: 100%; }
.cover-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.body {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.row-name { display: flex; align-items: center; }
.name {
  flex: 1;
  min-width: 0;
  font-size: 31rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}
.meta {
  font-size: 23rpx;
  color: var(--c-sub);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 2rpx;
}

.side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-end;
  flex-shrink: 0;
}
/* 状态描述文字（已过期 N 天/还剩 N 天等）：移入卡片内部 body，颜色由 lv-text-* 承担 */
.status-label { font-size: 26rpx; font-weight: 600; white-space: nowrap; margin-top: 6rpx; }

/* 语义状态色：组件样式默认隔离，不继承 app.wxss 的 lv-text-* / bar-inner.lv-* 规则
 * （只有 --c-* 自定义属性经 .page-root 继承穿透），故组件内必须本地重声明，
 * 使描述文字与进度条颜色跟状态徽章统一（用户 2026-09-08 反馈） */
.status-label.lv-text-expired { color: var(--c-danger); }
.status-label.lv-text-warning { color: var(--c-warn); }
.status-label.lv-text-safe { color: var(--c-safe); }
.status-label.lv-text-memo { color: var(--c-memo); }
.status-label.lv-text-warranty { color: var(--c-memo); }

/* 进度条轨道与填充色（同上隔离原因本地声明） */
.bar { height: 8rpx; border-radius: 999rpx; background: var(--c-card-2); overflow: hidden; }
.bar-inner { height: 100%; border-radius: 999rpx; }
.bar-inner.lv-expired { background: var(--c-danger); }
.bar-inner.lv-warning { background: var(--c-warn); }
.bar-inner.lv-safe { background: var(--c-safe); }
.bar-inner.lv-memo { background: var(--c-memo); }
.bar-inner.lv-warranty { background: var(--c-memo); }
.cal-tag {
  font-size: 20rpx;
  color: var(--c-sub);
  border: 1rpx solid var(--c-line);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

/* 底色与圆点缩小一档，透明触控区仍不小于 44px。 */
.has-menu .side { justify-content: space-between; gap: 16rpx; }
.more-button {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  min-width: 44px;
  min-height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
}
.more-button::before {
  content: "";
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  left: 4rpx;
  border-radius: 18rpx;
  background: var(--c-secondary-bg);
}
.more-dot { position: relative; width: 7rpx; height: 7rpx; min-width: 3.5px; min-height: 3.5px; border-radius: 50%; background: var(--c-secondary-text); }
.more-button-hover { opacity: 0.75; }

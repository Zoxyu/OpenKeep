<view class="item-card" hover-class="item-card-hover" bindtap="onTap" wx:if="{{item}}">
  <!-- 封面：本地照片，缺失时展示分类色块占位 -->
  <view class="cover">
    <image
      wx:if="{{item.photoOk && item.photoPath}}"
      class="cover-img"
      src="{{item.photoPath}}"
      mode="aspectFill"
    />
    <view
      wx:else
      class="cover-ph"
      style="background:{{dark ? item.toneDarkAlpha : item.toneAlpha}};color:{{dark ? item.toneDark : item.tone}};"
    >{{item.categoryChar}}</view>
  </view>

  <!-- 中部信息 -->
  <view class="body">
    <view class="row-name">
      <view class="name">{{item.name}}</view>
      <status-badge level="{{item.status.level}}" text="{{item.status.levelText}}" size="small" />
    </view>
    <view class="meta">{{item.categoryLabel}} · 开封于 {{item.openedAt}}</view>
    <view wx:if="{{item.status.dueDate}}" class="meta">到期 {{item.status.dueDate}}</view>
    <view wx:elif="{{item.status.level === 'warranty'}}" class="meta">保修至 {{item.warrantyEnd}}</view>
    <view class="bar">
      <view class="bar-inner lv-{{item.status.level}}" style="width:{{item.status.progress}}%;"></view>
    </view>
  </view>

  <!-- 右侧状态 -->
  <view class="side">
    <view class="left-label lv-text-{{item.status.level}}">{{item.status.label}}</view>
    <view wx:if="{{item.calendarImported}}" class="cal-tag">已入日历</view>
  </view>
</view>

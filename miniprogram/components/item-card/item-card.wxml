<view class="item-card {{showMenu ? 'has-menu' : ''}}" hover-class="item-card-hover" bindtap="onTap" wx:if="{{item}}">
  <!-- 封面：本地照片，缺失时展示分类色块占位 -->
  <view class="cover">
    <image
      wx:if="{{item.photoOk && item.photoPath}}"
      class="cover-img"
      src="{{item.photoPath}}"
      mode="aspectFill"
    />
    <view
      wx:else
      class="cover-ph"
      style="background:{{dark ? item.toneDarkAlpha : item.toneAlpha}};color:{{dark ? item.toneDark : item.tone}};"
    >{{item.categoryChar}}</view>
  </view>

  <!-- 中部信息 -->
  <view class="body">
    <!-- 状态徽章固定右上角（描述文字已移入卡片内部，不再挤占右上角） -->
    <view class="row-name">
      <view class="name">{{item.name}}</view>
      <status-badge level="{{item.status.level}}" text="{{item.status.levelText}}" size="small" />
    </view>
    <!-- 主日期行：到期/保修/维护优先，开始使用日期仅作无日期时（纯备忘）的回退显示 -->
    <view class="meta">{{item.categoryLabel}} · {{item.status.dueDate ? '到期 ' + item.status.dueDate : (item.status.level === 'warranty' ? '保修至 ' + item.warrantyEnd : (item.maintenance.active ? '维护至 ' + item.maintenance.nextDate : '开始使用于 ' + item.openedAt))}}</view>
    <!-- 状态描述文字（已过期 N 天/还剩 N 天/保修剩余）移入卡片内部；备忘的描述与徽章重复不显示 -->
    <view wx:if="{{item.status.level !== 'memo'}}" class="status-label lv-text-{{item.status.level}}">{{item.status.label}}</view>
    <view class="bar">
      <view class="bar-inner lv-{{item.status.level}}" style="width:{{item.status.progress}}%;"></view>
    </view>
  </view>

  <!-- 菜单独占右侧点击区域；catchtap 阻止误触卡片详情。 -->
  <view class="side">
    <view wx:if="{{showMenu}}" class="more-button" catchtap="onMore" hover-class="more-button-hover" hover-stop-propagation="{{true}}" aria-role="button" aria-label="{{item.name}}，更多操作">
      <view class="more-dot"></view><view class="more-dot"></view><view class="more-dot"></view>
    </view>
      <view wx:if="{{item.calendarLabel}}" class="cal-tag">{{item.calendarLabel}}</view>
  </view>
</view>

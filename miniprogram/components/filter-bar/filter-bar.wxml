<scroll-view class="filter-bar" scroll-x="true" enable-flex="true" enhanced="true" show-scrollbar="false">
  <view
    wx:for="{{options}}"
    wx:key="key"
    class="fb-chip {{active === item.key ? 'fb-chip-on' : ''}}"
    data-key="{{item.key}}"
    hover-class="fb-chip-hover"
    bindtap="onTap"
  >
    <text>{{item.label}}</text>
    <text wx:if="{{item.count !== undefined}}" class="fb-count">{{item.count}}</text>
  </view>
</scroll-view>

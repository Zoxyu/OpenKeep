/* 快捷筛选条：圆角选项自动换行（避免横滑，保证一屏可见）。 */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 12rpx;
  padding: 8rpx 40rpx;
}
.fb-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 calc(33.33% - 12rpx);
  min-width: calc(33.33% - 12rpx);
  min-height: 68rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-control);
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  color: var(--c-sub);
  font-size: 26rpx;
}
.fb-chip-hover { opacity: 0.8; }
.fb-chip-on {
  background: var(--c-selected-bg);
  border-color: var(--c-selected-line);
  color: var(--c-selected-text);
  font-weight: 500;
}
.fb-count { margin-left: 10rpx; font-size: 22rpx; opacity: 0.7; }
.fb-chip-on .fb-count { opacity: 1; }

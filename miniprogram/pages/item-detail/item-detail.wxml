<view wx:if="{{themeReady}}" class="page-root {{dark ? 'theme-dark' : ''}}">

  <!-- 主体内容：scroll-view 承担纵向滚动（页面已 disableScroll，锁死 iOS 双向拖拽） -->
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">

  <!-- 记录不存在（已被删除等边界情况） -->
  <view wx:if="{{loadError}}" class="missing">
    <view class="missing-title">暂时无法读取物品</view>
    <view class="missing-desc">记录未被修改，请重试。</view>
    <view class="btn btn-primary missing-btn" hover-class="btn-hover" bindtap="refresh">重新读取</view>
  </view>
  <view wx:elif="{{missing}}" class="missing">
    <view class="missing-title">记录不存在</view>
    <view class="missing-desc">这条物品可能已被删除。</view>
    <view class="btn btn-primary missing-btn" hover-class="btn-hover" bindtap="goBack">返回</view>
  </view>

  <block wx:elif="{{record}}">
    <!-- 照片 / 分类占位 -->
    <view class="hero-photo">
      <image wx:if="{{photoOk && record.photoPath}}" class="hero-img" src="{{record.photoPath}}" mode="aspectFill" />
      <view
        wx:else
        class="hero-ph"
        style="background:{{dark ? cat.toneDarkAlpha : cat.toneAlpha}};color:{{dark ? cat.toneDark : cat.tone}};"
      >{{cat.char}}</view>
    </view>

    <!-- 名称与状态 -->
    <view class="head-card card">
      <view class="head-row">
        <view class="head-name">{{record.name}}</view>
        <status-badge level="{{status.level}}" text="{{status.levelText}}" />
      </view>
      <view class="head-label lv-text-{{status.level}}">{{status.label}}</view>
      <view class="bar head-bar">
        <view class="bar-inner lv-{{status.level}}" style="width:{{status.progress}}%;"></view>
      </view>
      <view class="head-sub">保质期已消耗 {{status.progress}}%</view>
    </view>

    <!-- 基本信息 -->
    <view class="info-card card">
      <view class="cell">
        <view class="cell-title">分类</view>
        <view class="cell-value">{{cat.label}}</view>
      </view>
      <view class="cell">
        <view class="cell-title">开始使用日期</view>
        <view class="cell-value">{{record.openedAt}}</view>
      </view>
      <view class="cell">
        <view class="cell-title">已使用</view>
        <view class="cell-value">{{status.daysOpened > 0 ? status.daysOpened + ' 天' : '今天开始使用'}}</view>
      </view>
      <view wx:if="{{shelfLifeText}}" class="cell">
        <view class="cell-title">保质期</view>
        <view class="cell-value">{{shelfLifeText}}</view>
      </view>
      <view wx:if="{{record.openedDays > 0}}" class="cell">
        <view class="cell-title">开始使用后可用</view>
        <view class="cell-value">{{record.openedDays}} 天（优先按此提醒）</view>
      </view>
      <view wx:if="{{record.location}}" class="cell">
        <view class="cell-title">存放位置</view>
        <view class="cell-value">{{record.location}}</view>
      </view>
      <view wx:if="{{status.dueDate}}" class="cell">
        <view class="cell-title">到期日期</view>
        <view class="cell-value">{{status.dueDate}}</view>
      </view>
    </view>

    <!-- 购买与保修（M1，有值才展示；保修状态与到期红黄绿分离） -->
    <view wx:if="{{record.purchaseDate || priceText || warranty.hasWarranty}}" class="info-card card">
      <view wx:if="{{record.purchaseDate}}" class="cell">
        <view class="cell-title">购买日期</view>
        <view class="cell-value">{{record.purchaseDate}}</view>
      </view>
      <view wx:if="{{priceText}}" class="cell">
        <view class="cell-title">购买价格</view>
        <view class="cell-value">{{priceText}}</view>
      </view>
      <view wx:if="{{warranty.hasWarranty}}" class="cell">
        <view class="cell-title">保修结束</view>
        <view class="cell-value">{{warranty.endDate}}</view>
      </view>
      <view wx:if="{{warranty.hasWarranty}}" class="cell">
        <view class="cell-title">保修状态</view>
        <view class="cell-value {{warranty.expired ? 'lv-text-expired' : 'lv-text-safe'}}">{{warrantyLeftText}}<view wx:if="{{record.warrantyHandledDate === record.warrantyEnd}}" class="cal-note">本期提醒已处理</view></view>
      </view>
    </view>

    <!-- 维护周期（M1 第二批次，设置了才展示；下次维护日为派生值） -->
    <view wx:if="{{maintenance.active}}" class="info-card card">
      <view class="cell">
        <view class="cell-title">上次维护</view>
        <view class="cell-value">{{maintenance.lastDate}}</view>
      </view>
      <view class="cell">
        <view class="cell-title">维护周期</view>
        <view class="cell-value">{{maintenance.cycleText}}</view>
      </view>
      <view class="cell">
        <view class="cell-title">下次维护</view>
        <view class="cell-value">{{maintenance.nextDate}}</view>
      </view>
      <view class="cell">
        <view class="cell-title">维护状态</view>
        <view class="cell-value {{maintenance.overdue ? 'lv-text-expired' : 'lv-text-safe'}}">{{maintenance.label}}</view>
      </view>
      <view wx:if="{{!record.archived}}" class="maintenance-actions">
        <view
          class="btn btn-safe {{maintenanceDoneToday || completingMaintenance || writing ? 'btn-disabled' : ''}}"
          hover-class="{{maintenanceDoneToday || completingMaintenance || writing ? 'none' : 'btn-hover'}}"
          bindtap="onCompleteMaintenance"
        >{{maintenanceDoneToday ? '今天已记录维护' : (completingMaintenance ? '确认中…' : '已完成维护')}}</view>
        <view class="maintenance-note">按今天记录完成，下一次从今天起按原周期计算。补记其他日期可使用“编辑物品”。</view>
        <view wx:if="{{record.calendarImported}}" class="maintenance-note">已有日历提醒不会自动更新，旧提醒请在系统日历中管理。下一次维护如需提醒，请另行添加。</view>
      </view>
    </view>

    <!-- 备注 -->
    <view wx:if="{{record.notes}}" class="notes-card card">
      <view class="notes-title">备注</view>
      <view class="notes-body">{{record.notes}}</view>
    </view>

    <!-- 日历提醒（纯备忘无日期不可导入隐藏本栏；但设了维护周期的备忘可用维护日导入） -->
    <view wx:if="{{calendarEntry}}" class="cal-card card">
      <view class="cal-head">
        <view class="cal-title">到期提醒 · 手机日历</view>
        <view wx:if="{{calendarEntry.imported}}" class="cal-done">本期已添加</view>
      </view>
      <view wx:if="{{!calSupported}}" class="cal-note">当前微信版本或设备不支持写入系统日历，物品管理功能不受影响。</view>
      <block wx:else>
        <picker wx:if="{{calendarEntries.length > 1}}" mode="selector" range="{{calendarEntries}}" range-key="optionLabel" value="{{calendarIndex}}" disabled="{{calendarBusy || writing}}" bindchange="onCalendarKindChange">
          <view class="cal-picker"><text>{{calendarEntry.optionLabel}}</text><text class="picker-arrow">›</text></view>
        </picker>
        <view class="cal-desc">{{calendarEntry.label}}提醒 · {{calendarEntry.dueDate}} 上午 9:00，可选择提前通知时间。已过期的日期会调整为最近的未来上午 9:00。</view>
        <view wx:if="{{calendarEntry.legacyUnknown && !calendarEntry.imported}}" class="cal-note">旧提醒待核对：旧版本未记录类别和日期，添加前请先检查手机日历。</view>
        <picker mode="selector" range="{{reminderOptions}}" value="{{reminderIndex}}" disabled="{{calendarBusy || writing}}" bindchange="onReminderChange">
          <view class="cal-picker">
            <text>{{reminderOptions[reminderIndex]}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <view
          class="btn {{calendarEntry.imported ? 'btn-plain' : 'btn-safe'}} {{calendarBusy || writing || deleting ? 'btn-disabled' : ''}} cal-btn"
          hover-class="btn-hover"
          bindtap="onAddCalendar"
        >{{writing ? '添加中…' : (calendarBusy ? '确认中…' : (calendarEntry.imported ? '重新添加本期提醒' : '添加到手机日历'))}}</view>
        <view wx:if="{{calendarEntry.imported}}" class="cal-note">重新添加可能产生重复提醒。已添加的提醒请在系统日历中管理，本应用无法删除或修改。</view>
        <view wx:else class="cal-note">只写入你主动选择的提醒，不会读取你的已有日程。</view>
      </block>
    </view>

    <!-- 操作 -->
    <view wx:if="{{record.archived}}" class="cal-card card"><view class="cal-title">此物品已归档</view><view class="btn btn-plain cal-btn" bindtap="goArchive">查看处理记录 / 撤销</view></view>
    <view class="actions" wx:if="{{!record.archived}}">
      <view class="btn btn-safe" bindtap="goProcess" hover-class="btn-hover">记录处理结果</view>
      <view class="btn btn-plain" bindtap="goArchive" hover-class="btn-hover">查看处理记录</view>
      <view class="btn btn-primary" hover-class="btn-hover" bindtap="onEdit">编辑物品</view>
      <view class="btn btn-danger-ghost del-btn {{deleting ? 'btn-disabled' : ''}}" hover-class="btn-hover" bindtap="onDelete">{{deleting ? '删除中…' : '删除这条记录'}}</view>
    </view>
  </block>

  </scroll-view>

</view>

/* 物品详情页样式 */

.missing { padding: 160rpx 48rpx; text-align: center; }
.missing-title { font-size: 34rpx; font-weight: 600; }
.missing-desc { margin-top: 12rpx; font-size: 26rpx; color: var(--c-sub); }
.missing-btn { margin: 48rpx auto 0; width: 320rpx; }

/* ====== 顶部照片 ====== */
.hero-photo { margin: 32rpx 40rpx 0; border-radius: 24rpx; overflow: hidden; }
.hero-img { width: 100%; height: 420rpx; display: block; }
.hero-ph {
  width: 100%;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
  font-weight: 600;
  border-radius: 24rpx;
}

/* ====== 名称状态卡 ====== */
.head-card { margin: 28rpx 40rpx 0; padding: 32rpx; }
.head-row { display: flex; align-items: center; }
.head-name {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-right: 16rpx;
  word-break: break-all;
}
.head-label { margin-top: 14rpx; font-size: 30rpx; font-weight: 600; }
.head-bar { margin-top: 18rpx; height: 10rpx; }
.head-sub { margin-top: 12rpx; font-size: 23rpx; color: var(--c-faint); }

/* ====== 信息 / 备注卡 ====== */
.info-card { margin: 28rpx 40rpx 0; padding: 4rpx 0; }
.notes-card { margin: 28rpx 40rpx 0; padding: 28rpx 32rpx; }
.notes-title { font-size: 26rpx; color: var(--c-sub); margin-bottom: 10rpx; }
.notes-body { font-size: 28rpx; line-height: 1.7; word-break: break-all; }
.maintenance-actions { padding: 20rpx 32rpx 28rpx; }
.maintenance-note { margin-top: 16rpx; font-size: 24rpx; color: var(--c-sub); line-height: 1.6; }

/* ====== 日历卡 ====== */
.cal-card { margin: 28rpx 40rpx 0; padding: 30rpx 32rpx; }
.cal-head { display: flex; align-items: center; justify-content: space-between; }
.cal-title { font-size: 30rpx; font-weight: 600; }
.cal-done {
  font-size: 22rpx;
  color: var(--c-safe);
  background: var(--c-safe-bg);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.cal-desc { margin-top: 12rpx; font-size: 24rpx; color: var(--c-sub); }
.cal-picker {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: var(--c-card-2);
  border: 1rpx solid var(--c-line);
  border-radius: 18rpx;
  font-size: 29rpx;
}
.picker-arrow { color: var(--c-faint); font-size: 32rpx; }
.cal-btn { margin-top: 24rpx; }
.cal-note { margin-top: 16rpx; font-size: 22rpx; color: var(--c-faint); line-height: 1.6; }

/* ====== 操作 ====== */
.actions { padding: 40rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); }
.del-btn { margin-top: 20rpx; }

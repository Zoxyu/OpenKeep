<view wx:if="{{themeReady}}" class="page-root {{dark ? 'theme-dark' : ''}}">

  <!-- 主体内容：scroll-view 承担纵向滚动（页面已 disableScroll，锁死 iOS 双向拖拽） -->
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">

  <!-- 搜索框 -->
  <view class="search-wrap">
    <view class="search-box">
      <view class="search-icon"></view>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索名称、分类或备注"
        placeholder-class="ph-text"
        confirm-type="search"
        bindinput="onKeywordInput"
      />
      <view wx:if="{{keyword}}" class="search-clear" hover-class="clear-hover" bindtap="onKeywordClear">×</view>
    </view>
  </view>

  <!-- 筛选面板：固定网格布局，所有选项一屏可见，无需左右滑动 -->
  <view class="filter-panel">
    <!-- 分类：3 列两行 -->
    <view class="fp-group">
      <view class="fp-label">分类</view>
      <view class="fp-grid">
        <view
          wx:for="{{categoryOptions}}"
          wx:key="key"
          class="fp-cell {{category === item.key ? 'fp-cell-on' : ''}}"
          hover-class="fp-cell-hover"
          data-key="{{item.key}}"
          bindtap="onCategoryTap"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- 状态：4 列一行，选中时用红黄绿语义色 -->
    <view class="fp-group">
      <view class="fp-label">状态</view>
      <view class="fp-grid fp-grid-4">
        <view
          wx:for="{{statusOptions}}"
          wx:key="key"
          class="fp-cell fp-st-{{item.key}} {{status === item.key ? 'fp-cell-on' : ''}}"
          hover-class="fp-cell-hover"
          data-key="{{item.key}}"
          bindtap="onStatusTap"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- 排序：3 列一行 -->
    <view class="fp-group fp-group-last">
      <view class="fp-label">排序</view>
      <view class="fp-grid fp-grid-3">
        <view
          wx:for="{{sortOptions}}"
          wx:key="key"
          class="fp-cell {{sort === item.key ? 'fp-cell-on' : ''}}"
          hover-class="fp-cell-hover"
          data-key="{{item.key}}"
          bindtap="onSortTap"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 数据全部来自本地缓存、同步可得，onShow 内一次算完并一次 setData，
       因此不存在加载等待期，也就没有骨架屏阶段 -->
  <block>
    <!-- 完全没有记录 -->
    <empty-state
      wx:if="{{contentReady && !hasAny}}"
      type="box"
      title="还没有任何物品"
      desc="添加第一件开封物品，开始你的保质期看板。"
    />
    <view wx:if="{{contentReady && !hasAny}}" class="empty-action">
      <view class="btn btn-primary empty-btn" hover-class="btn-hover" bindtap="goAdd">＋ 添加物品</view>
    </view>

    <!-- 有记录但筛选无结果 -->
    <empty-state
      wx:elif="{{contentReady && !list.length}}"
      type="search"
      title="没有找到匹配的物品"
      desc="试试更换关键词，或放宽分类与状态筛选。"
    />

    <!-- 结果列表（contentReady 前不渲染，避免中间帧闪「共 0 件」） -->
    <view wx:elif="{{contentReady}}" class="list">
      <view class="list-count">共 {{list.length}} 件{{filtered ? '（已筛选）' : ''}}</view>
      <block wx:for="{{list}}" wx:key="id">
        <item-card item="{{item}}" dark="{{dark}}" bind:tapitem="onCardTap" />
      </block>
    </view>
  </block>

  </scroll-view>

</view>

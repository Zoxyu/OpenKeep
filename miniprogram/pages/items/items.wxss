/* 物品页样式 */

/* ====== 搜索框 ====== */
.search-wrap { padding: 24rpx 40rpx 8rpx; }
.search-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  border-radius: 999rpx;
  box-shadow: var(--c-shadow);
}
/* CSS 绘制的放大镜 */
.search-icon {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid var(--c-faint);
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.search-clear {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-faint);
  font-size: 36rpx;
  flex-shrink: 0;
}
.clear-hover { opacity: 0.6; }
.search-input { flex: 1; font-size: 28rpx; height: 88rpx; }

/* ====== 筛选面板：固定网格，一屏可见无需滑动 ====== */
.filter-panel {
  margin: 20rpx 40rpx 0;
  padding: 24rpx 24rpx 10rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  border-radius: 24rpx;
  box-shadow: var(--c-shadow);
}
.fp-group { margin-bottom: 24rpx; }
.fp-group-last { margin-bottom: 12rpx; }
.fp-label {
  padding: 0 8rpx;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: var(--c-faint);
}

/* 单元格网格：flex 换行 + nth-child 消除行尾间距 */
.fp-grid { display: flex; flex-wrap: wrap; }
.fp-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  margin-bottom: 14rpx;
  border-radius: 16rpx;
  background: var(--c-card-2);
  color: var(--c-sub);
  font-size: 25rpx;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
}
.fp-cell-hover { opacity: 0.8; }

/* 默认 3 列（分类、排序） */
.fp-cell { width: calc((100% - 32rpx) / 3); margin-right: 16rpx; }
.fp-cell:nth-child(3n) { margin-right: 0; }

/* 4 列（状态） */
.fp-grid-4 .fp-cell { width: calc((100% - 48rpx) / 4); margin-right: 16rpx; }
.fp-grid-4 .fp-cell:nth-child(3n) { margin-right: 16rpx; }
.fp-grid-4 .fp-cell:nth-child(4n) { margin-right: 0; }

/* 选中态：默认墨色填充 */
.fp-cell-on {
  background: var(--c-text);
  color: var(--c-bg);
  font-weight: 500;
}

/* 状态选中时改用红黄绿语义色（浅深色模式变量自适应） */
.fp-cell-on.fp-st-expired { background: var(--c-danger-bg); color: var(--c-danger); }
.fp-cell-on.fp-st-warning { background: var(--c-warn-bg); color: var(--c-warn); }
.fp-cell-on.fp-st-safe { background: var(--c-safe-bg); color: var(--c-safe); }
.fp-cell-on.fp-st-memo { background: var(--c-memo-bg); color: var(--c-memo); }
.fp-cell-on.fp-st-warranty { background: var(--c-memo-bg); color: var(--c-memo); }

/* 骨架屏样式已删除：数据来自本地缓存、同步可得，不再存在加载等待期 */

/* ====== 列表 ====== */
/* 底部预留悬浮胶囊 tabBar 的高度，避免最后一项被遮挡 */
.list { padding: 8rpx 40rpx 220rpx; }
.list-count { padding: 16rpx 4rpx; font-size: 24rpx; color: var(--c-faint); }

/* 底部再预留悬浮胶囊 tabBar 高度（含 safe-area）：极矮屏下空态 CTA 仍可滚动到遮挡区之上 */
.empty-action { display: flex; justify-content: center; padding: 0 96rpx calc(160rpx + env(safe-area-inset-bottom)); }
.empty-btn { width: 100%; }

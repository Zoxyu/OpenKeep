/* 新增 / 编辑物品页样式 */

/* ====== 封面照片区 ====== */
.photo-area {
  margin: 32rpx 40rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  box-shadow: var(--c-shadow);
}
.photo-hover { opacity: 0.92; }
.photo-img { width: 100%; height: 380rpx; display: block; }
.photo-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: #FFFFFF;
  background: rgba(32, 36, 33, 0.45);
}
.photo-empty {
  height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--c-faint);
  border-radius: 24rpx;
  margin: 16rpx;
  box-sizing: border-box;
}
/* CSS 绘制的加号 */
.photo-plus {
  width: 64rpx;
  height: 64rpx;
  position: relative;
  margin-bottom: 20rpx;
}
.photo-plus::before,
.photo-plus::after {
  content: "";
  position: absolute;
  background: var(--c-faint);
  border-radius: 4rpx;
}
.photo-plus::before { left: 28rpx; top: 4rpx; width: 8rpx; height: 56rpx; }
.photo-plus::after { left: 4rpx; top: 28rpx; width: 56rpx; height: 8rpx; }
.photo-empty-text { font-size: 28rpx; color: var(--c-sub); }
.photo-empty-sub { margin-top: 8rpx; font-size: 23rpx; color: var(--c-faint); }

/* ====== 表单卡片 ====== */
.form-card { margin: 28rpx 40rpx 0; padding-bottom: 12rpx; }
.field-sub { margin-top: 10rpx; font-size: 23rpx; color: var(--c-faint); }

/* 分类选择 */
.cat-row { display: flex; gap: 14rpx; }
.cat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0 14rpx;
  border-radius: 18rpx;
  background: var(--c-card-2);
  border: 2rpx solid transparent;
}
.cat-hover { opacity: 0.85; }
.cat-on { border-color: var(--c-safe); background: var(--c-safe-bg); }
.cat-char { font-size: 32rpx; font-weight: 600; }
.cat-label { margin-top: 4rpx; font-size: 21rpx; color: var(--c-sub); }

/* 日期选择行 */
.picker-row { display: flex; align-items: center; justify-content: space-between; line-height: 88rpx; }
.picker-arrow { color: var(--c-faint); font-size: 32rpx; }

/* 备注 */
.notes-input { min-height: 150rpx; padding: 20rpx 24rpx; box-sizing: border-box; }
.notes-count { margin-top: 8rpx; text-align: right; font-size: 22rpx; color: var(--c-faint); }

/* ====== 操作按钮 ====== */
.actions {
  padding: 40rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
}
.del-btn { margin-top: 20rpx; }

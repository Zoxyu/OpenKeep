<view wx:if="{{themeReady}}" class="page-root {{dark ? 'theme-dark' : ''}}">
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="hh-body">
      <view class="hh-heading">记录处理结果</view>
      <view wx:if="{{loadError}}" class="card hh-empty"><view>暂时无法读取记录</view><view class="btn btn-plain hh-add" bindtap="refresh">重新读取</view></view>
      <block wx:elif="{{contentReady}}">
        <view class="hh-sub">{{title}}</view>
        <view wx:if="{{!options.length}}" class="card hh-empty">{{unavailableText}}<view class="btn btn-plain hh-add" bindtap="goArchive">查看处理记录</view></view>
        <block wx:else>
          <view class="card hh-note-card">
            <view class="hh-title">处理方式</view>
            <view class="hh-choices hh-add"><view wx:for="{{options}}" wx:key="key" class="hh-choice {{kind === item.key ? 'hh-choice-on' : ''}}" data-kind="{{item.key}}" bindtap="onKind">{{item.label}}</view></view>
            <view wx:if="{{needsNext}}" class="hh-add">
              <view class="hh-title">确认下一期日期</view>
              <picker mode="date" value="{{nextDate}}" disabled="{{saving}}" bindchange="onDate"><view class="hh-picker">{{nextDate}}<text>修改 ›</text></view></picker>
              <view class="hh-sub">本期日期：{{item.dueDate}}。可以按实际缴费、续期或换证结果调整下一期。</view>
            </view>
            <view class="hh-sub">{{resultText}}</view>
          </view>
          <view class="hh-sub">处理记录会保留在“处理记录与归档”中；误操作可撤销最近一次处理。已添加的手机日历提醒需在系统日历中管理。</view>
          <view wx:if="{{error}}" class="hh-status hh-overdue hh-add">{{error}}</view>
          <view class="btn btn-primary hh-add {{saving ? 'btn-disabled' : ''}}" bindtap="onSave" hover-class="btn-hover">{{saving ? '保存中…' : '确认处理'}}</view>
        </block>
      </block>
    </view>
  </scroll-view>
</view>

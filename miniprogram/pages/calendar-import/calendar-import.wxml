<view wx:if="{{themeReady}}" class="page-root {{dark ? 'theme-dark' : ''}}">

  <!-- 主体内容：scroll-view 承担纵向滚动（页面已 disableScroll，锁死 iOS 双向拖拽）
       底部操作栏与结果弹层为 fixed 定位，留在滚动区外 -->
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">

  <!-- 不支持时的降级提示 -->
  <view wx:if="{{!supported}}" class="warn-banner">当前微信版本或设备不支持写入系统日历。你仍可正常使用物品看板。</view>

  <view class="intro">
    <view class="intro-title">选择物品提醒</view>
    <view class="intro-desc">已过期与未来 90 天内到期的物品、保修即将到期的物品、以及维护即将到期的物品（30 天内，含超期）会显示在这里。导入后，将在对应日期上午 9:00 添加提醒。</view>
    <view class="intro-desc">同一物品的保质期、保修、维保分别选择。旧版提醒未记录类别和日期，标为“待核对”，请检查手机日历后再勾选。</view>
  </view>

  <!-- 选项区 -->
  <view class="opt-card card" wx:if="{{hasCandidates}}">
    <view class="cell">
      <view>
        <view class="cell-title">统一提醒时间</view>
        <view class="cell-sub">对所有选中提醒生效</view>
      </view>
      <picker class="opt-picker" mode="selector" range="{{reminderOptions}}" value="{{reminderIndex}}" disabled="{{importing || confirming}}" bindchange="onReminderChange">
        <view class="cell-value">{{reminderOptions[reminderIndex]}} <text class="picker-arrow">›</text></view>
      </picker>
    </view>
    <view class="cell">
      <view>
        <view class="cell-title">跳过本期已添加提醒</view>
        <view class="cell-sub">避免产生重复提醒</view>
      </view>
      <switch checked="{{skipImported}}" color="#3E8F72" disabled="{{importing || confirming}}" bindchange="onSkipChange" />
    </view>
    <view class="cell">
      <view>
        <view class="cell-title">纳入超过 30 天的保修</view>
        <view class="cell-sub">默认只提醒 30 天内到期的保修</view>
      </view>
      <switch checked="{{warrantyBeyond30}}" color="#3E8F72" disabled="{{importing || confirming}}" bindchange="onWarrantyBeyondChange" />
    </view>
    <view class="cell">
      <view class="cell-title">全选可选记录</view>
      <view class="select-all" hover-class="sa-hover" bindtap="onToggleAll">
        <view class="checkbox {{checkedCount > 0 ? 'on' : ''}}"><view wx:if="{{checkedCount > 0}}" class="tick"></view></view>
        <text class="sa-text">全选 / 取消全选</text>
      </view>
    </view>
  </view>

  <!-- 候选列表 -->
  <view wx:if="{{hasCandidates}}" class="ci-list">
    <view
      wx:for="{{items}}"
      wx:key="key"
      class="ci-item {{item.disabled ? 'ci-disabled' : ''}}"
      data-index="{{index}}"
      hover-class="{{item.disabled || importing ? '' : 'ci-hover'}}"
      bindtap="onToggle"
    >
      <view class="checkbox {{item.checked ? 'on' : ''}} {{item.disabled ? 'disabled' : ''}}">
        <view wx:if="{{item.checked}}" class="tick"></view>
      </view>
      <view class="ci-body">
        <view class="ci-name">{{item.record.name}}</view>
        <view class="ci-meta">{{item.label}} · {{item.dueDate}}</view>
      </view>
      <view class="ci-right">
        <status-badge level="{{item.level}}" text="{{item.levelText}}" size="small" />
        <view wx:if="{{item.imported}}" class="ci-imported">本期已添加</view>
        <view wx:elif="{{item.legacyUnknown}}" class="ci-imported">旧提醒待核对</view>
        <view wx:else class="ci-left lv-text-{{item.level}}">{{item.remainingText}}</view>
      </view>
    </view>
  </view>
  <!-- 空状态：contentReady 前不渲染，避免中间帧（候选列表尚未由 onShow buildList 填入）闪「暂无需要提醒的物品」 -->
  <view wx:elif="{{loadError}}" class="opt-card card">
    <view class="cell"><view class="cell-title">暂时无法读取物品，请重试。</view></view>
    <view class="btn btn-plain" bindtap="buildList">重新读取</view>
  </view>
  <empty-state
    wx:elif="{{contentReady}}"
    type="calendar"
    title="暂无需要提醒的物品"
    desc="已过期与未来 90 天内到期的物品、保修与维护即将到期的物品会自动出现在这里。"
  />

  </scroll-view>

  <!-- 底部操作区 -->
  <view class="bottom-bar">
    <block wx:if="{{!importing}}">
      <view class="bb-count">已选 {{checkedCount}} 条</view>
      <view
        class="btn btn-primary bb-btn {{checkedCount === 0 || !supported || confirming ? 'btn-disabled' : ''}}"
        hover-class="btn-hover"
        bindtap="onImport"
      >{{confirming ? '确认中…' : '导入 ' + checkedCount + ' 条到手机日历'}}</view>
    </block>
    <block wx:else>
      <view class="bb-progress">
        <view class="bb-progress-text">{{progressText}}</view>
        <view class="bar bb-bar">
          <view class="bar-inner lv-safe" style="width:{{progressPct}}%;"></view>
        </view>
      </view>
      <view class="btn btn-plain bb-cancel" hover-class="btn-hover" bindtap="onCancelImport">取消</view>
    </block>
  </view>

  <!-- 结果面板 -->
  <view wx:if="{{showResult}}" class="result-mask">
    <view class="result-card">
      <view class="result-title">{{resultCancelled ? '已停止导入' : '导入完成'}}</view>
      <view class="result-summary">
        <text class="r-ok">成功 {{resultSuccess}} 条</text>
        <text wx:if="{{resultFail > 0}}" class="r-fail">失败 {{resultFail}} 条</text>
      </view>
      <view wx:if="{{failList.length}}" class="result-fails">
        <view class="rf-title">失败原因</view>
        <scroll-view class="rf-list" scroll-y="true">
          <view wx:for="{{failList}}" wx:key="index" class="rf-item">
            <view class="rf-name">{{item.name}}</view>
            <view class="rf-reason">{{item.reason}}</view>
          </view>
        </scroll-view>
      </view>
      <view wx:if="{{markerWarning}}" class="result-note">部分提醒已提交，但本地标记未保存或记录已变化；再次导入前请检查手机日历，避免重复。</view>
      <view class="result-note">已添加的提醒请在系统日历中管理，本应用无法删除或修改。重复导入会产生重复提醒。</view>
      <view class="btn btn-primary result-btn" hover-class="btn-hover" bindtap="onCloseResult">完成</view>
    </view>
  </view>

</view>

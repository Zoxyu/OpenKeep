@import "../../styles/floating-actions.wxss";

/* 首页看板样式 */

/* 仅看板使用更轻的层次；变量向物品卡继承，不改变其他页面。 */
.page-root.dashboard-page { --c-shadow: 0 4rpx 18rpx rgba(32, 36, 33, 0.035); }
.page-root.dashboard-page.theme-dark { --c-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.16); }

/* ====== 顶部问候 ====== */
.hero { padding: 40rpx 40rpx 32rpx; }
.hero-date { display: inline-flex; padding: 6rpx 16rpx; border-radius: 12rpx; background: var(--c-card-2); font-size: 23rpx; color: var(--c-sub); }
.hero-greet { margin-top: 12rpx; font-size: 25rpx; color: var(--c-sub); }
.hero-brand { margin-top: 16rpx; font-size: 46rpx; font-weight: 600; letter-spacing: 4rpx; line-height: 1.3; }
.hero-sub { margin-top: 8rpx; font-size: 22rpx; color: var(--c-sub); }

/* ====== 物品概览：与家庭事项使用同一套卡片层级 ====== */
.stats-panel { margin: 28rpx 40rpx 0; overflow: hidden; }
.stats-head { padding: 28rpx 28rpx 0; font-size: 31rpx; font-weight: 600; }
.stats { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 24rpx 28rpx 28rpx; }
.stat {
  flex: 1 1 calc(33.33% - 8rpx);
  min-width: calc(33.33% - 8rpx);
  box-sizing: border-box;
  background: var(--c-card-2);
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}
.stat-hover { opacity: 0.88; transform: translateY(2rpx); }
.stat-num { font-size: 38rpx; font-weight: 600; line-height: 1.3; }
.stat-label { margin-top: 8rpx; font-size: 23rpx; color: var(--c-sub); }

/* ====== 新手引导卡 ====== */
.guide {
  margin: 28rpx 40rpx 0;
  background: var(--c-card);
  border-radius: 24rpx;
  border: 1rpx solid var(--c-line);
  box-shadow: var(--c-shadow);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.guide-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx dashed var(--c-safe);
  box-sizing: border-box;
  margin-bottom: 24rpx;
}
.guide-title { font-size: 31rpx; font-weight: 600; }
.guide-desc { margin-top: 10rpx; font-size: 25rpx; color: var(--c-sub); max-width: 480rpx; }
.guide-btn {
  margin-top: 30rpx;
  padding: 18rpx 44rpx;
  border-radius: 22rpx;
  background: var(--c-action-bg);
  color: var(--c-action-text);
  font-size: 28rpx;
}

/* ====== 历史上的今天卡片 ====== */
.today-card {
  display: flex;
  align-items: center;
  margin: 28rpx 40rpx 0;
  background: var(--c-card);
  border-radius: 24rpx;
  border: 1rpx solid var(--c-line);
  box-shadow: var(--c-shadow);
  padding: 28rpx;
}
.today-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 96rpx;
  min-height: 112rpx;
  padding: 12rpx 0;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--c-card-2);
}
.today-m { font-size: 22rpx; color: var(--c-sub); }
.today-m::after { content: "月"; margin-left: 2rpx; }
.today-d {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--c-safe);
}
.today-body { flex: 1; min-width: 0; margin-left: 24rpx; }
.today-title { font-size: 31rpx; font-weight: 600; }
.today-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--c-sub);
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.today-more { margin-top: 12rpx; font-size: 25rpx; color: var(--c-sub); }

/* ====== 列表区 ====== */
.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 36rpx 40rpx 16rpx;
}
.list-title { font-size: 31rpx; font-weight: 600; }
.list-total { font-size: 25rpx; color: var(--c-sub); }
/* 底部预留悬浮胶囊 tabBar 与添加/搜索按钮的避让空间；
 * 搜索按钮顶边＝296rpx+safe-area+88rpx，故留白必须含 safe-area，
 * 否则 iOS 模拟（safe≈34px）下滚到底时搜索按钮压住最后一张卡片（安卓/华为模拟 safe=0 不复现） */
.list { padding: 16rpx 40rpx calc(420rpx + env(safe-area-inset-bottom)); }

/* ====== 搜索入口与搜索框：沿用卡片与添加按钮的圆角语言 ====== */
.fab-search {
  position: fixed;
  right: 40rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom) + 116rpx);
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-action);
  background: var(--c-control-bg);
  border: 1rpx solid var(--c-control-line);
  box-shadow: var(--c-floating-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
/* CSS 绘制的放大镜 */
.fab-search-icon {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid var(--c-control-text);
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
}
.fab-search-icon::after {
  content: "";
  position: absolute;
  right: -9rpx;
  bottom: -7rpx;
  width: 12rpx;
  height: 4rpx;
  background: var(--c-control-text);
  border-radius: 2rpx;
  transform: rotate(45deg);
}
.dash-search-wrap { padding: 28rpx 40rpx 0; }
.dash-search-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  border-radius: var(--radius-card);
  box-shadow: var(--c-shadow);
}
.dash-search-icon {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid var(--c-faint);
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.dash-search-icon::after {
  content: "";
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 10rpx;
  height: 4rpx;
  background: var(--c-faint);
  border-radius: 2rpx;
  transform: rotate(45deg);
}
.dash-search-input { flex: 1; min-width: 0; font-size: 28rpx; height: 88rpx; color: var(--c-text); }
.dash-search-clear {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-faint);
  font-size: 36rpx;
  flex-shrink: 0;
}

/* ====== 首次启动引导浮层 ====== */
.onboard-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 22, 25, 0.5);
  z-index: 999;
}
.onboard-card {
  position: absolute;
  left: 56rpx;
  right: 56rpx;
  top: 50%;
  transform: translateY(-50%);
  background: var(--c-card);
  border-radius: 32rpx;
  padding: 64rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.onboard-logo {
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  background: var(--c-safe);
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}
.onboard-name { font-size: 40rpx; font-weight: 700; letter-spacing: 4rpx; }
.onboard-sub { margin-top: 8rpx; font-size: 23rpx; color: var(--c-faint); }
.onboard-desc { margin: 28rpx 0 36rpx; font-size: 26rpx; color: var(--c-sub); line-height: 1.7; }
.onboard-btn { width: 100%; margin-top: 18rpx; }

/* ====== 统一待处理与后续安排 ====== */
.reminder-panel { margin: 0 40rpx; overflow: hidden; }
.reminder-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx; padding: 14rpx 28rpx 0; }
.reminder-title { font-size: 31rpx; font-weight: 600; }
.reminder-link { min-height: 76rpx; display: flex; align-items: center; color: var(--c-secondary-text); font-size: 25rpx; }
.reminder-intro { padding: 0 28rpx 20rpx; font-size: 23rpx; color: var(--c-sub); }
.reminder-tabs { display: flex; padding: 0 28rpx 24rpx; }
.reminder-tab { flex: 1; min-width: 0; padding: 16rpx 4rpx; border-radius: var(--radius-control); text-align: center; font-size: 23rpx; color: var(--c-sub); background: var(--c-card-2); }
.reminder-tab + .reminder-tab { margin-left: 12rpx; }
.reminder-tab-active { background: var(--c-selected-bg); color: var(--c-selected-text); }
.theme-dark .reminder-tab-active { background: var(--c-secondary-bg); color: var(--c-secondary-text); }
.reminder-num { margin-bottom: 6rpx; font-size: 38rpx; font-weight: 600; line-height: 1.3; }
.reminder-caption { padding: 0 28rpx 18rpx; font-size: 22rpx; color: var(--c-sub); line-height: 1.6; }
.reminder-row { display: flex; align-items: center; padding: 22rpx 24rpx 22rpx 28rpx; border-top: 1rpx solid var(--c-line); }
.reminder-body { flex: 1; min-width: 0; margin-right: 16rpx; }
.reminder-type { display: inline-block; padding: 4rpx 12rpx; border-radius: 8rpx; background: var(--c-card-2); color: var(--c-sub); font-size: 21rpx; }
.reminder-name { margin-top: 8rpx; font-size: 29rpx; font-weight: 500; overflow-wrap: break-word; word-break: break-all; }
.reminder-date { margin-top: 10rpx; font-size: 23rpx; color: var(--c-sub); }
.reminder-status { margin-top: 6rpx; font-size: 25rpx; }
.reminder-overdue { color: var(--c-danger); }
.reminder-today { color: var(--c-warn); }
.reminder-upcoming, .reminder-later { color: var(--c-secondary-text); }
/* 与物品卡同尺寸：视觉稍收小，实际触控区仍至少 44px；无描边。 */
.reminder-more { position: relative; width: 88rpx; height: 88rpx; min-width: 44px; min-height: 44px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; gap: 7rpx; }
.reminder-more::before { content: ''; position: absolute; top: 4rpx; right: 4rpx; bottom: 4rpx; left: 4rpx; border-radius: 18rpx; background: var(--c-secondary-bg); }
.reminder-dot { position: relative; width: 7rpx; height: 7rpx; min-width: 3.5px; min-height: 3.5px; border-radius: 50%; background: var(--c-secondary-text); }
.reminder-more-hover { opacity: .75; }
.reminder-expand { min-height: 88rpx; display: flex; align-items: center; justify-content: center; padding: 0 12rpx; font-size: 25rpx; color: var(--c-secondary-text); border-top: 1rpx solid var(--c-line); }
.reminder-empty { padding: 12rpx 28rpx 28rpx; line-height: 1.7; font-size: 26rpx; color: var(--c-sub); }
.reminder-later-head { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; padding: 24rpx 28rpx; background: var(--c-card-2); font-size: 27rpx; font-weight: 500; }
.reminder-later-count { font-size: 23rpx; color: var(--c-sub); font-weight: normal; }
.reminder-bottom { padding: 0 28rpx 24rpx; }
.reminder-add { margin-top: 16rpx; font-size: 28rpx; letter-spacing: 0; }
.reminder-error { margin: 0 28rpx 24rpx; padding: 20rpx 20rpx 0; border-radius: 16rpx; background: var(--c-card-2); color: var(--c-sub); font-size: 25rpx; line-height: 1.6; }

.archive-entry { margin: 28rpx 40rpx 0; padding: 24rpx 28rpx; display: flex; justify-content: space-between; font-size: 26rpx; color: var(--c-sub); }

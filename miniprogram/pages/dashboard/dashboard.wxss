/* 首页看板样式 */

/* ====== 顶部问候 ====== */
.hero { padding: 48rpx 40rpx 4rpx; }
.hero-date { font-size: 26rpx; color: var(--c-sub); letter-spacing: 2rpx; }
.hero-greet { margin-top: 6rpx; font-size: 26rpx; color: var(--c-sub); }
.hero-brand { margin-top: 26rpx; font-size: 62rpx; font-weight: 700; letter-spacing: 8rpx; line-height: 1.25; }
.hero-sub { margin-top: 4rpx; font-size: 23rpx; color: var(--c-faint); letter-spacing: 1rpx; }

/* ====== 三色统计卡 ====== */
.stats { display: flex; gap: 20rpx; padding: 36rpx 40rpx 0; }
.stat {
  flex: 1;
  background: var(--c-card);
  border-radius: 22rpx;
  border: 1rpx solid var(--c-line);
  box-shadow: var(--c-shadow);
  padding: 26rpx 0 22rpx;
  text-align: center;
}
.stat-hover { opacity: 0.88; transform: translateY(2rpx); }
.stat-num { font-size: 48rpx; font-weight: 700; line-height: 1.2; }
.stat-label { margin-top: 4rpx; font-size: 23rpx; color: var(--c-sub); }

/* ====== 主提醒卡 ====== */
.urgent {
  margin: 32rpx 40rpx 0;
  background: var(--c-card);
  border-radius: 24rpx;
  border: 1rpx solid var(--c-line);
  box-shadow: var(--c-shadow);
  padding: 30rpx 32rpx;
}
.urgent-head { display: flex; align-items: center; justify-content: space-between; }
.urgent-tag { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 999rpx; }
.lv-bg-expired { color: var(--c-danger); background: var(--c-danger-bg); }
.lv-bg-warning { color: var(--c-warn); background: var(--c-warn-bg); }
.lv-bg-safe { color: var(--c-safe); background: var(--c-safe-bg); }
.urgent-more { font-size: 23rpx; color: var(--c-faint); }
.urgent-name { margin-top: 22rpx; font-size: 38rpx; font-weight: 600; letter-spacing: 1rpx; }
.urgent-meta { margin-top: 8rpx; font-size: 24rpx; color: var(--c-sub); }
.urgent-bar { margin-top: 22rpx; height: 10rpx; }
.urgent-label { margin-top: 18rpx; font-size: 29rpx; font-weight: 600; }

/* ====== 新手引导卡 ====== */
.guide {
  margin: 32rpx 40rpx 0;
  background: var(--c-card);
  border-radius: 24rpx;
  border: 1rpx dashed var(--c-faint);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.guide-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx dashed var(--c-safe);
  box-sizing: border-box;
  margin-bottom: 24rpx;
}
.guide-title { font-size: 32rpx; font-weight: 600; }
.guide-desc { margin-top: 10rpx; font-size: 25rpx; color: var(--c-sub); max-width: 480rpx; }
.guide-btn {
  margin-top: 30rpx;
  padding: 18rpx 44rpx;
  border-radius: 999rpx;
  background: var(--c-text);
  color: var(--c-bg);
  font-size: 28rpx;
}

/* ====== 历史上的今天卡片 ====== */
.today-card {
  display: flex;
  align-items: center;
  margin: 28rpx 40rpx 0;
  background: var(--c-card);
  border-radius: 24rpx;
  border: 1rpx solid var(--c-line);
  box-shadow: var(--c-shadow);
  padding: 28rpx 32rpx;
}
.today-date {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  width: 96rpx;
}
.today-m { font-size: 28rpx; font-weight: 700; }
.today-d {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  margin-left: 4rpx;
  color: var(--c-safe);
}
.today-body { flex: 1; min-width: 0; margin-left: 24rpx; }
.today-title { font-size: 28rpx; font-weight: 600; letter-spacing: 1rpx; }
.today-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--c-sub);
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.today-more { margin-top: 8rpx; font-size: 22rpx; color: var(--c-faint); }

/* ====== 近期保修提醒（M1，轻量） ====== */
.warranty-card { margin: 28rpx 40rpx 0; padding: 28rpx 32rpx; }
.warranty-head { display: flex; align-items: baseline; justify-content: space-between; }
.warranty-title { font-size: 28rpx; font-weight: 600; letter-spacing: 1rpx; }
.warranty-sub { font-size: 22rpx; color: var(--c-faint); }
.warranty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 12rpx 0;
}
.warranty-row + .warranty-row { border-top: 1rpx solid var(--c-line); }
.warranty-name {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.warranty-days { flex-shrink: 0; font-size: 25rpx; color: var(--c-warn); }

/* ====== 列表区 ====== */
.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 44rpx 40rpx 8rpx;
}
.list-title { font-size: 31rpx; font-weight: 600; letter-spacing: 1rpx; }
.list-total { font-size: 24rpx; color: var(--c-faint); }
/* 底部预留悬浮胶囊 tabBar 与添加按钮的避让空间 */
.list { padding: 16rpx 40rpx 380rpx; }

/* ====== 悬浮添加按钮 ====== */
.fab {
  position: fixed;
  right: 40rpx;
  /* 抬升至悬浮胶囊 tabBar 之上 */
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 44rpx;
  border-radius: 999rpx;
  background: var(--c-text);
  color: var(--c-bg);
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  box-shadow: 0 14rpx 36rpx rgba(32, 36, 33, 0.24);
  z-index: 50;
}
.fab-hover { opacity: 0.85; transform: translateY(2rpx); }
.fab-plus { font-size: 36rpx; margin-right: 10rpx; }

/* ====== 搜索入口（添加按钮旁的圆形按钮）与搜索框 ====== */
.fab-search {
  position: fixed;
  right: 40rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom) + 116rpx);
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  box-shadow: 0 14rpx 36rpx rgba(32, 36, 33, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
/* CSS 绘制的放大镜 */
.fab-search-icon {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid var(--c-sub);
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
}
.fab-search-icon::after {
  content: "";
  position: absolute;
  right: -9rpx;
  bottom: -7rpx;
  width: 12rpx;
  height: 4rpx;
  background: var(--c-sub);
  border-radius: 2rpx;
  transform: rotate(45deg);
}
.dash-search-wrap { padding: 24rpx 40rpx 0; }
.dash-search-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  border-radius: 999rpx;
  box-shadow: var(--c-shadow);
}
.dash-search-icon {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid var(--c-faint);
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.dash-search-icon::after {
  content: "";
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 10rpx;
  height: 4rpx;
  background: var(--c-faint);
  border-radius: 2rpx;
  transform: rotate(45deg);
}
.dash-search-input { flex: 1; font-size: 28rpx; height: 88rpx; }
.dash-search-clear {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-faint);
  font-size: 36rpx;
  flex-shrink: 0;
}

/* ====== 首次启动引导浮层 ====== */
.onboard-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 22, 25, 0.5);
  z-index: 999;
}
.onboard-card {
  position: absolute;
  left: 56rpx;
  right: 56rpx;
  top: 50%;
  transform: translateY(-50%);
  background: var(--c-card);
  border-radius: 32rpx;
  padding: 64rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.onboard-logo {
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  background: var(--c-safe);
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}
.onboard-name { font-size: 40rpx; font-weight: 700; letter-spacing: 4rpx; }
.onboard-sub { margin-top: 8rpx; font-size: 23rpx; color: var(--c-faint); }
.onboard-desc { margin: 28rpx 0 36rpx; font-size: 26rpx; color: var(--c-sub); line-height: 1.7; }
.onboard-btn { width: 100%; margin-top: 18rpx; }

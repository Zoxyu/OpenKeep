<!-- 已创建的 Tab 随 dark 同步页面底色及原生栏；不等待下次 onShow 才改色。 -->
<page-meta wx:if="{{themeReady}}"
  page-style="background-color: {{dark ? '#141619' : '#F7F7F4'}}; color: {{dark ? '#E8EAE6' : '#202421'}};"
  root-background-color="{{dark ? '#141619' : '#F7F7F4'}}"
  background-color="{{dark ? '#141619' : '#F7F7F4'}}"
  background-color-top="{{dark ? '#141619' : '#F7F7F4'}}"
  background-color-bottom="{{dark ? '#141619' : '#F7F7F4'}}">
  <navigation-bar background-color="{{dark ? '#141619' : '#F7F7F4'}}"
    front-color="{{dark ? '#ffffff' : '#000000'}}" color-animation-duration="{{0}}" />
</page-meta>

<template name="reminder-row">
  <view class="reminder-row" data-key="{{entry.key}}" bindtap="onReminderTap" hover-class="card-hover">
    <view class="reminder-body">
      <view class="reminder-type">{{entry.typeText}}</view>
      <view class="reminder-name">{{entry.title}}</view>
      <view class="reminder-date">{{entry.dueDate}}</view>
      <view class="reminder-status reminder-{{entry.period}}">{{entry.label}}</view>
    </view>
    <view class="reminder-more" data-key="{{entry.key}}" catchtap="onReminderMore" hover-class="reminder-more-hover" hover-stop-propagation="{{true}}" role="button" aria-label="{{entry.title + '，' + entry.typeText + '，更多操作'}}">
      <view class="reminder-dot"></view><view class="reminder-dot"></view><view class="reminder-dot"></view>
    </view>
  </view>
</template>

<view wx:if="{{themeReady}}" class="page-root dashboard-page {{dark ? 'theme-dark' : ''}}">

  <!-- 首次启动引导：用户主动选择，不擅自写入演示数据 -->
  <view wx:if="{{showOnboarding}}" class="onboard-mask">
    <view class="onboard-card">
      <view class="onboard-logo">期</view>
      <view class="onboard-name">到期那天</view>
      <view class="onboard-sub">In Time · 到期那天，还来得及</view>
      <view class="onboard-desc">记下物品的开始使用日期，随时查看到期、保修与维保信息。所有数据仅保存在你的手机本地，不上传、不联网。</view>
      <view class="btn btn-primary onboard-btn" hover-class="btn-hover" bindtap="onUseDemo">体验示例数据</view>
      <view class="btn btn-plain onboard-btn" hover-class="btn-hover" bindtap="onStartBlank">从空白开始</view>
    </view>
  </view>

  <!-- 主体内容：scroll-view 承担纵向滚动（页面已 disableScroll，锁死 iOS 双向拖拽） -->
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-default-style="none"
    refresher-background="transparent"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onScrollRefresh"
    bindrefresherpulling="onRefresherPulling"
    bindrefresherrestore="onRefresherRestore"
    bindrefresherabort="onRefresherAbort"
  >
  <!-- 自定义下拉刷新区域（refresher-default-style="none"，slot 节点须有高度，见 app.wxss .rf） -->
  <view slot="refresher" class="rf">
    <view class="rf-dot {{refreshing ? 'rf-loading' : ''}}"></view>
    <text class="rf-text">{{refresherText}}</text>
  </view>

  <!-- 顶部问候 -->
  <view class="hero">
    <view class="hero-date">{{todayText}}</view>
    <view class="hero-greet">今天，值得被记住。</view>
    <view class="hero-brand">到期那天</view>
    <view class="hero-sub">In Time · Keep track of what you open.</view>
  </view>

  <!-- 按提醒日期统一汇总；不同类别保留各自语义和处理入口。 -->
  <view wx:if="{{contentReady}}" class="reminder-panel card">
    <view class="reminder-head">
      <view class="reminder-title">近期需处理</view>
      <view class="reminder-link" hover-class="card-hover" bindtap="goHousehold">管理事项 ›</view>
    </view>
    <view class="reminder-intro">物品与家庭事项一起看</view>
    <view wx:if="{{recordError || householdError}}" class="reminder-error">
      <view>{{recordError && householdError ? '物品和家庭事项暂时无法读取。' : recordError ? '物品暂时无法读取，当前仅展示家庭事项。' : '家庭事项暂时无法读取，当前仅展示物品。'}}</view>
      <view class="reminder-link" bindtap="refresh" hover-class="card-hover">重新读取 ›</view>
    </view>
    <view class="reminder-tabs">
      <view wx:for="{{reminders.groups}}" wx:key="key" class="reminder-tab {{reminderGroup === item.key ? 'reminder-tab-active' : ''}}" data-key="{{item.key}}" bindtap="onReminderGroup" hover-class="card-hover" role="button" aria-label="{{item.label + '，' + item.count + ' 条提醒'}}">
        <view class="reminder-num reminder-{{item.key}}">{{item.count}}</view><view>{{item.label}}</view>
      </view>
    </view>
    <view class="reminder-caption">按日期排列 · 同一物品的不同日期分别提醒</view>
    <block wx:for="{{reminderItems}}" wx:key="key"><template is="reminder-row" data="{{entry: item}}" /></block>
    <view wx:if="{{!reminderCount}}" class="reminder-empty">{{recordError || householdError ? '当前可读取的数据中，暂无这段时间的提醒。' : reminderGroup === 'overdue' ? '没有超期提醒。' : reminderGroup === 'today' ? '今天暂无需要处理的提醒。' : '未来 7 天暂无到期提醒。'}}</view>
    <view wx:if="{{reminderCount > 3}}" class="reminder-expand" hover-class="card-hover" bindtap="onToggleReminders">{{reminderExpanded ? '收起提醒' : '展开全部 ' + reminderCount + ' 条提醒'}}</view>
    <block wx:if="{{reminders.later.count}}">
      <view class="reminder-later-head"><text>后续安排</text><text class="reminder-later-count">{{reminders.later.count}} 条</text></view>
      <block wx:for="{{laterExpanded ? reminders.later.items : reminders.later.preview}}" wx:key="key"><template is="reminder-row" data="{{entry: item}}" /></block>
      <view wx:if="{{reminders.later.count > 3}}" class="reminder-expand" hover-class="card-hover" bindtap="onToggleLater">{{laterExpanded ? '收起安排' : '展开全部 ' + reminders.later.count + ' 条安排'}}</view>
    </block>
    <view class="reminder-bottom"><view class="btn btn-plain reminder-add" hover-class="btn-hover" bindtap="goAddHousehold">＋ 添加家庭事项</view></view>
  </view>

  <!-- 物品统计不混入事项；仅有事项时不显示整排零值。 -->
  <view wx:if="{{contentReady && !recordError && (hasRecords || (!householdOverview.total && !householdError))}}" class="stats-panel card">
    <view class="stats-head">物品概览</view>
    <view class="stats">
      <view class="stat" hover-class="stat-hover" bindtap="onStatTap" data-level="expired">
        <view class="stat-num lv-text-expired">{{stats.expired}}</view>
        <view class="stat-label">已过期</view>
      </view>
      <view class="stat" hover-class="stat-hover" bindtap="onStatTap" data-level="warning">
        <view class="stat-num lv-text-warning">{{stats.warning}}</view>
        <view class="stat-label">临期</view>
      </view>
      <view class="stat" hover-class="stat-hover" bindtap="onStatTap" data-level="safe">
        <view class="stat-num lv-text-safe">{{stats.safe}}</view>
        <view class="stat-label">安心保存</view>
      </view>
      <view wx:if="{{stats.warranty > 0}}" class="stat" hover-class="stat-hover" bindtap="onStatTap" data-level="warranty">
        <view class="stat-num lv-text-warranty">{{stats.warranty}}</view>
        <view class="stat-label">保修</view>
      </view>
      <view wx:if="{{stats.memo > 0}}" class="stat" hover-class="stat-hover" bindtap="onStatTap" data-level="memo">
        <view class="stat-num lv-text-memo">{{stats.memo}}</view>
        <view class="stat-label">备忘</view>
      </view>
    </view>
  </view>

  <!-- 无记录时的温和引导 -->
  <view wx:if="{{contentReady && !hasRecords && !recordError && !householdOverview.total && !householdError && !showOnboarding}}" class="guide" hover-class="card-hover" bindtap="goAdd">
    <view class="guide-circle"></view>
    <view class="guide-title">从第一件物品开始</view>
    <view class="guide-desc">拍下或录入开始使用的物品，到期的事交给看板替你记着。</view>
    <view class="guide-btn">＋ 添加第一件物品</view>
  </view>

  <!-- 历史上的今天：柔和日期卡（点击进入 tab 页） -->
  <view wx:if="{{historyPreview}}" class="today-card" hover-class="card-hover" bindtap="goHistory">
    <view class="today-date">
      <text class="today-m">{{historyPreview.month}}</text>
      <text class="today-d">{{historyPreview.day}}</text>
    </view>
    <view class="today-body">
      <view class="today-title">历史上的今天</view>
      <view wx:if="{{historyPreview.text}}" class="today-text">{{historyPreview.text}}</view>
      <view class="today-more">查看全部 ›</view>
    </view>
  </view>

  <!-- 关键词搜索框（点击悬浮搜索按钮展开） -->
  <view wx:if="{{searchOpen}}" class="dash-search-wrap">
    <view class="dash-search-box">
      <view class="dash-search-icon"></view>
      <input
        class="dash-search-input"
        value="{{keyword}}"
        placeholder="搜索名称、分类、位置或备注"
        placeholder-class="ph-text"
        confirm-type="search"
        adjust-position="{{false}}"
        bindinput="onSearchInput"
      />
      <view wx:if="{{keyword}}" class="dash-search-clear" hover-class="clear-hover" bindtap="onSearchClear">×</view>
    </view>
  </view>

  <view wx:if="{{contentReady}}" class="archive-entry card" bindtap="goArchive" hover-class="card-hover"><text>处理记录与归档</text><text>查看 ›</text></view>

  <!-- 列表区（list-head 与 filter-bar 均由 contentReady 守卫，门开帧不显示「共 0 件」与空筛选栏） -->
  <view wx:if="{{contentReady}}" class="list-head">
    <view class="list-title">物品看板</view>
    <view class="list-total">{{recordError ? '暂时无法读取' : '共 ' + total + ' 件'}}</view>
  </view>

  <filter-bar wx:if="{{contentReady && !recordError}}" options="{{filterOptions}}" active="{{filter}}" bind:change="onFilterChange" />

  <!-- 列表外层容器同样由 contentReady 守卫：避免中间帧渲染一个空容器（padding 造成）加剧 pop-in 布局跳动 -->
  <view wx:if="{{contentReady}}" class="list">
    <block wx:for="{{list}}" wx:key="id">
      <item-card item="{{item}}" dark="{{dark}}" show-menu="{{true}}" bind:tapitem="onCardTap" bind:more="onItemMore" />
    </block>
    <empty-state
      wx:if="{{contentReady && !list.length}}"
      type="box"
      title="{{recordError ? '物品暂时无法读取' : hasRecords ? '该状态下暂无物品' : '还没有物品记录'}}"
      desc="{{recordError ? '请下拉刷新重试。' : hasRecords ? '换个筛选条件，看看其他物品。' : '点击右下角按钮，添加第一件物品。'}}"
    />
  </view>
  </scroll-view>

  <!-- 悬浮添加按钮 -->
  <view class="fab" hover-class="fab-hover" bindtap="goAdd">
    <text class="fab-plus">＋</text>
    <text class="fab-text">添加物品</text>
  </view>

  <!-- 搜索入口（添加按钮上方） -->
  <view class="fab-search" hover-class="fab-hover" bindtap="onToggleSearch">
    <view class="fab-search-icon"></view>
  </view>

</view>

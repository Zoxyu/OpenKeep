<view wx:if="{{themeReady}}" class="page-root dashboard-page {{dark ? 'theme-dark' : ''}}">

  <!-- 首次启动引导：用户主动选择，不擅自写入演示数据 -->
  <view wx:if="{{showOnboarding}}" class="onboard-mask">
    <view class="onboard-card">
      <view class="onboard-logo">期</view>
      <view class="onboard-name">到期那天</view>
      <view class="onboard-sub">In Time · 到期那天，还来得及</view>
      <view class="onboard-desc">记下物品的开始使用日期，随时查看到期、保修与维保信息。所有数据仅保存在你的手机本地，不上传、不联网。</view>
      <view class="btn btn-primary onboard-btn" hover-class="btn-hover" bindtap="onUseDemo">体验示例数据</view>
      <view class="btn btn-plain onboard-btn" hover-class="btn-hover" bindtap="onStartBlank">从空白开始</view>
    </view>
  </view>

  <!-- 主体内容：scroll-view 承担纵向滚动（页面已 disableScroll，锁死 iOS 双向拖拽） -->
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-default-style="none"
    refresher-background="transparent"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onScrollRefresh"
    bindrefresherpulling="onRefresherPulling"
    bindrefresherrestore="onRefresherRestore"
    bindrefresherabort="onRefresherAbort"
  >
  <!-- 自定义下拉刷新区域（refresher-default-style="none"，slot 节点须有高度，见 app.wxss .rf） -->
  <view slot="refresher" class="rf">
    <view class="rf-dot {{refreshing ? 'rf-loading' : ''}}"></view>
    <text class="rf-text">{{refresherText}}</text>
  </view>

  <!-- 顶部问候 -->
  <view class="hero">
    <view class="hero-date">{{todayText}}</view>
    <view class="hero-greet">今天，值得被记住。</view>
    <view class="hero-brand">到期那天</view>
    <view class="hero-sub">In Time · Keep track of what you open.</view>
  </view>

  <!-- 家庭事项直接展示；空态保留录入入口，错误态独立于物品。 -->
  <view wx:if="{{contentReady}}" class="household-panel card">
    <view class="household-head">
      <view class="household-title">家庭事项</view>
      <view class="household-link" hover-class="card-hover" bindtap="goHousehold">{{householdError ? '管理事项' : '全部 ' + householdOverview.total + ' 件'}} ›</view>
    </view>
    <view wx:if="{{householdError}}" class="household-empty">
      <view>暂时无法读取家庭事项，请重试。</view>
      <view class="btn btn-plain household-add" bindtap="refresh">重新读取</view>
    </view>
    <block wx:else>
      <block wx:if="{{householdOverview.total}}">
        <view class="household-stats">
          <view class="household-stat"><view class="household-num lv-text-expired">{{householdOverview.overdue}}</view><view>已超期</view></view>
          <view class="household-stat"><view class="household-num lv-text-warning">{{householdOverview.today}}</view><view>今天需处理</view></view>
          <view class="household-stat"><view class="household-num">{{householdOverview.upcoming}}</view><view>未来 7 天</view></view>
        </view>
        <view class="household-caption">按处理日期排列 · 超期事项优先</view>
        <view wx:for="{{householdExpanded ? householdOverview.items : householdOverview.preview}}" wx:key="id" class="household-row" data-id="{{item.id}}" bindtap="goHouseholdDetail" hover-class="card-hover">
          <view class="household-name">{{item.title}}</view>
          <view class="household-meta">{{item.typeText}} · {{item.repeatText}}</view>
          <view class="household-date-row"><text>{{item.dueDate}}</text><text class="household-status household-{{item.status.level}}">{{item.status.label}} ›</text></view>
          <view class="btn btn-plain process-link" catchtap="goProcess" data-source="household" data-id="{{item.id}}" hover-class="btn-hover">标记已处理</view>
        </view>
        <view wx:if="{{householdOverview.total > 3}}" class="household-expand" hover-class="card-hover" bindtap="onToggleHousehold">{{householdExpanded ? '收起事项' : '展开全部 ' + householdOverview.total + ' 件事项'}}</view>
      </block>
      <view wx:else class="household-empty">记下缴费续费、保险续期或证件到期，保存后会显示在这里。</view>
      <view class="household-bottom"><view class="btn btn-plain household-add" hover-class="btn-hover" bindtap="goAddHousehold">＋ 添加事项</view></view>
    </block>
  </view>

  <!-- 物品统计不混入事项；仅有事项时不显示整排零值。 -->
  <view wx:if="{{contentReady && (hasRecords || (!householdOverview.total && !householdError))}}" class="stats-panel card">
    <view class="stats-head">物品概览</view>
    <view class="stats">
      <view class="stat" hover-class="stat-hover" bindtap="onStatTap" data-level="expired">
        <view class="stat-num lv-text-expired">{{stats.expired}}</view>
        <view class="stat-label">已过期</view>
      </view>
      <view class="stat" hover-class="stat-hover" bindtap="onStatTap" data-level="warning">
        <view class="stat-num lv-text-warning">{{stats.warning}}</view>
        <view class="stat-label">临期</view>
      </view>
      <view class="stat" hover-class="stat-hover" bindtap="onStatTap" data-level="safe">
        <view class="stat-num lv-text-safe">{{stats.safe}}</view>
        <view class="stat-label">安心保存</view>
      </view>
      <view wx:if="{{stats.warranty > 0}}" class="stat" hover-class="stat-hover" bindtap="onStatTap" data-level="warranty">
        <view class="stat-num lv-text-warranty">{{stats.warranty}}</view>
        <view class="stat-label">保修</view>
      </view>
      <view wx:if="{{stats.memo > 0}}" class="stat" hover-class="stat-hover" bindtap="onStatTap" data-level="memo">
        <view class="stat-num lv-text-memo">{{stats.memo}}</view>
        <view class="stat-label">备忘</view>
      </view>
    </view>
  </view>

  <!-- 主提醒卡：最紧急的一件 -->
  <view wx:if="{{urgent}}" class="urgent" hover-class="card-hover" bindtap="goDetail" data-id="{{urgent.id}}">
    <view class="urgent-head">
      <view class="urgent-tag lv-bg-{{urgent.status.level}}">{{urgent.status.level === 'expired' ? '需要尽快处理' : '临期提醒'}}</view>
      <view class="urgent-more">查看详情 ›</view>
    </view>
    <view class="urgent-name">{{urgent.name}}</view>
    <view class="urgent-meta">{{urgent.categoryLabel}} · 到期 {{urgent.status.dueDate}}</view>
    <view class="bar urgent-bar">
      <view class="bar-inner lv-{{urgent.status.level}}" style="width:{{urgent.status.progress}}%;"></view>
    </view>
    <view class="urgent-label lv-text-{{urgent.status.level}}">{{urgent.status.label}}</view>
  </view>

  <!-- 无记录时的温和引导 -->
  <view wx:elif="{{contentReady && !hasRecords && !householdOverview.total && !householdError && !showOnboarding}}" class="guide" hover-class="card-hover" bindtap="goAdd">
    <view class="guide-circle"></view>
    <view class="guide-title">从第一件物品开始</view>
    <view class="guide-desc">拍下或录入开始使用的物品，到期的事交给看板替你记着。</view>
    <view class="guide-btn">＋ 添加第一件物品</view>
  </view>

  <!-- 近期保修提醒（M1，轻量；独立于三色到期统计，不改变其含义） -->
  <view wx:if="{{warrantySoon.length}}" class="warranty-card card">
    <view class="warranty-head">
      <view class="warranty-title">近期保修</view>
      <view class="warranty-sub">{{warrantySoon.length}} 件即将过保</view>
    </view>
    <view
      wx:for="{{warrantySoon}}"
      wx:key="id"
      class="warranty-row"
      hover-class="card-hover"
      bindtap="goDetail"
      data-id="{{item.id}}"
    >
      <view class="warranty-name">{{item.name}}</view>
      <view class="warranty-days">{{item.warrantyText}}</view>
    </view>
  </view>

  <!-- 历史上的今天：柔和日期卡（点击进入 tab 页） -->
  <view wx:if="{{historyPreview}}" class="today-card" hover-class="card-hover" bindtap="goHistory">
    <view class="today-date">
      <text class="today-m">{{historyPreview.month}}</text>
      <text class="today-d">{{historyPreview.day}}</text>
    </view>
    <view class="today-body">
      <view class="today-title">历史上的今天</view>
      <view wx:if="{{historyPreview.text}}" class="today-text">{{historyPreview.text}}</view>
      <view class="today-more">查看全部 ›</view>
    </view>
  </view>

  <!-- 关键词搜索框（点击悬浮搜索按钮展开） -->
  <view wx:if="{{searchOpen}}" class="dash-search-wrap">
    <view class="dash-search-box">
      <view class="dash-search-icon"></view>
      <input
        class="dash-search-input"
        value="{{keyword}}"
        placeholder="搜索名称、分类、位置或备注"
        placeholder-class="ph-text"
        confirm-type="search"
        adjust-position="{{false}}"
        bindinput="onSearchInput"
      />
      <view wx:if="{{keyword}}" class="dash-search-clear" hover-class="clear-hover" bindtap="onSearchClear">×</view>
    </view>
  </view>

  <view wx:if="{{contentReady}}" class="archive-entry card" bindtap="goArchive" hover-class="card-hover"><text>处理记录与归档</text><text>查看 ›</text></view>

  <!-- 列表区（list-head 与 filter-bar 均由 contentReady 守卫，门开帧不显示「共 0 件」与空筛选栏） -->
  <view wx:if="{{contentReady}}" class="list-head">
    <view class="list-title">物品看板</view>
    <view class="list-total">共 {{total}} 件</view>
  </view>

  <filter-bar wx:if="{{contentReady}}" options="{{filterOptions}}" active="{{filter}}" bind:change="onFilterChange" />

  <!-- 列表外层容器同样由 contentReady 守卫：避免中间帧渲染一个空容器（padding 造成）加剧 pop-in 布局跳动 -->
  <view wx:if="{{contentReady}}" class="list">
    <block wx:for="{{list}}" wx:key="id">
      <item-card item="{{item}}" dark="{{dark}}" show-menu="{{true}}" bind:tapitem="onCardTap" bind:more="onItemMore" />
    </block>
    <empty-state
      wx:if="{{contentReady && !list.length}}"
      type="box"
      title="{{hasRecords ? '该状态下暂无物品' : '还没有物品记录'}}"
      desc="{{hasRecords ? '换个筛选条件，看看其他物品。' : '点击右下角按钮，添加第一件物品。'}}"
    />
  </view>
  </scroll-view>

  <!-- 悬浮添加按钮 -->
  <view class="fab" hover-class="fab-hover" bindtap="goAdd">
    <text class="fab-plus">＋</text>
    <text class="fab-text">添加物品</text>
  </view>

  <!-- 搜索入口（添加按钮上方） -->
  <view class="fab-search" hover-class="fab-hover" bindtap="onToggleSearch">
    <view class="fab-search-icon"></view>
  </view>

</view>

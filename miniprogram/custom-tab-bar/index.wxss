/* 自定义悬浮胶囊 tabBar
 * 浅色 / 深色主题变量定义在组件根节点（组件不在页面 DOM 内，无法继承页面变量）。
 * 图标全部由 CSS 绘制（currentColor 跟随文字色），不依赖任何外部图片。 */

.tabbar-shell {
  /* iOS 风格毛玻璃：更明显的半透明 + 强模糊 + 顶部高光细边 + 轻阴影；active 为可平移的柔和胶囊 */
  --tb-bg: rgba(255, 255, 255, 0.62);
  --tb-line: rgba(32, 36, 33, 0.06);
  --tb-shadow: 0 10rpx 30rpx rgba(32, 36, 33, 0.12), inset 0 1rpx 0 rgba(255, 255, 255, 0.55);
  --tb-sub: #8A8F8B;
  --tb-active-bg: rgba(32, 36, 33, 0.08);
  --tb-active-text: #202421;

  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 32rpx calc(28rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.tabbar-shell.theme-dark {
  --tb-bg: rgba(26, 29, 33, 0.60);
  --tb-line: rgba(255, 255, 255, 0.12);
  --tb-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  --tb-sub: #8F9691;
  --tb-active-bg: rgba(255, 255, 255, 0.14);
  --tb-active-text: #E8EAE6;
}

/* 悬浮胶囊容器：flex 弹性布局，任意屏宽下三等分不变形 */
.tabbar {
  position: relative;
  display: flex;
  align-items: center;
  padding: 10rpx;
  border-radius: 999rpx;
  background: var(--tb-bg);
  border: 1rpx solid var(--tb-line);
  box-shadow: var(--tb-shadow);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  backdrop-filter: blur(40rpx) saturate(180%);
}

/* 滑块指示器：随 thumbPos 平移（transform 过渡），iOS 质感的「按钮平移」动效。
 * 宽 = (容器内宽)/4，translateX(thumbPos*100%) 恰好移到对应 tab；置于图标下层（z-index 低于 tab-item）。 */
.tab-thumb {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  width: calc((100% - 20rpx) / 4);
  border-radius: 999rpx;
  background: var(--tb-active-bg);
  transition: transform 0.32s cubic-bezier(0.34, 1.15, 0.5, 1);
  z-index: 0;
  pointer-events: none;
}
/* 同步 / 首帧时禁用过渡，让滑块瞬移到位（不产生错误方向的滑动） */
.tab-thumb.no-anim { transition: none; }

/* 单个入口：纵向图标 + 文字，最小触控高度 96rpx */
.tab-item {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  border-radius: 999rpx;
  color: var(--tb-sub);
  transition: color 0.24s ease;
}
.tab-hover { opacity: 0.75; }

/* 选中态：背景由滑块 .tab-thumb 承担，这里只强化图标/文字颜色 */
.tab-active {
  color: var(--tb-active-text);
}
.tab-active .tab-text { font-weight: 600; }

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  flex-shrink: 0;
}
.tab-text {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.4;
  white-space: nowrap;
  color: currentColor;
}

/* ====== CSS 图标：看板（2×2 方格） ====== */
.icon-board .i-dot {
  position: absolute;
  width: 15rpx;
  height: 15rpx;
  border-radius: 4rpx;
  background: currentColor;
}
.i-d1 { left: 3rpx; top: 3rpx; }
.i-d2 { right: 3rpx; top: 3rpx; }
.i-d3 { left: 3rpx; bottom: 3rpx; }
.i-d4 { right: 3rpx; bottom: 3rpx; }

/* ====== CSS 图标：物品（盒盖 + 盒身） ====== */
.icon-box .i-lid {
  position: absolute;
  left: 7rpx;
  top: 5rpx;
  width: 30rpx;
  height: 10rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}
.icon-box .i-body {
  position: absolute;
  left: 7rpx;
  top: 17rpx;
  width: 30rpx;
  height: 19rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}

/* ====== CSS 图标：我的（头 + 肩） ====== */
.icon-me .i-head {
  position: absolute;
  left: 13rpx;
  top: 3rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}
.icon-me .i-body2 {
  position: absolute;
  left: 8rpx;
  top: 23rpx;
  width: 28rpx;
  height: 15rpx;
  border: 3rpx solid currentColor;
  border-radius: 14rpx 14rpx 0 0;
  box-sizing: border-box;
}

/* ====== CSS 图标：今天（日历） ====== */
.icon-today .i-frame {
  position: absolute;
  left: 6rpx;
  top: 8rpx;
  width: 32rpx;
  height: 30rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  box-sizing: border-box;
}
.icon-today .i-line {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  top: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
}
.icon-today .i-ear {
  position: absolute;
  top: 2rpx;
  width: 5rpx;
  height: 9rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 3rpx 3rpx 0 0;
  box-sizing: border-box;
}
.i-ear-l { left: 12rpx; }
.i-ear-r { right: 12rpx; }

<view class="tabbar-shell {{dark ? 'theme-dark' : ''}}">
  <view class="tabbar">
    <!-- 滑块指示器：随 thumbPos 平移（selected 决定文字/图标高亮），iOS 质感的按钮平移动效，置于图标下层 -->
    <view class="tab-thumb {{noAnim ? 'no-anim' : ''}}" style="transform: translateX({{thumbPos * 100}}%);"></view>
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'tab-active' : ''}}"
      data-index="{{index}}"
      hover-class="tab-hover"
      bindtap="switchTab"
    >
      <!-- CSS 绘制的图标：看板 / 物品 / 我的 -->
      <view class="tab-icon icon-{{item.icon}}">
        <block wx:if="{{item.icon === 'board'}}">
          <view class="i-dot i-d1"></view>
          <view class="i-dot i-d2"></view>
          <view class="i-dot i-d3"></view>
          <view class="i-dot i-d4"></view>
        </block>
        <block wx:elif="{{item.icon === 'box'}}">
          <view class="i-lid"></view>
          <view class="i-body"></view>
        </block>
        <block wx:elif="{{item.icon === 'today'}}">
          <view class="i-frame">
            <view class="i-line"></view>
          </view>
          <view class="i-ear i-ear-l"></view>
          <view class="i-ear i-ear-r"></view>
        </block>
        <block wx:else>
          <view class="i-head"></view>
          <view class="i-body2"></view>
        </block>
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>

/**
 * 到期那天 In Time · 全局样式
 * 设计语言：克制、温暖、轻奢。暖白底 + 墨黑文字 + 低饱和红黄绿语义色。
 * 深浅色主题通过 CSS 变量切换：页面根节点挂 .page-root（深色再挂 .theme-dark）。
 * 自定义属性可穿透组件边界向下继承，组件内部直接使用 var(--c-xxx) 即可。
 */

page {
  background-color: #F7F7F4;
  color: #202421;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 原生 page 元素必须自己跟随深色，否则会出现「先浅色、再深色」的首帧闪烁：
 * .page-root 的深色靠 data.dark 驱动（JS 状态），而 page 元素在它之外、更早绘制，
 * 此前被硬编码成浅色，深色模式下任何一帧没被 .page-root 盖住就会露出浅底。
 * app.json 已开启 darkmode: true，故这里用官方的 prefers-color-scheme 媒体查询，
 * 让 page 在系统深色时首帧即深色，与 theme.json 的 @bg 保持一致（同为 #141619）。
 * 说明：该查询跟随「系统」主题；用户在设置里手动锁定主题时，以铺满视口的
 * .page-root（min-height: 100vh）的变量为准，视觉上仍然正确。 */
@media (prefers-color-scheme: dark) {
  page {
    background-color: #141619;
    color: #E8EAE6;
  }
}

/* ====== 页面根容器：承载主题变量 ====== */
.page-root {
  --c-bg: #F7F7F4;
  --c-card: #FFFFFF;
  --c-card-2: #F1F2EE;
  --c-text: #202421;
  --c-sub: #858C86;
  --c-faint: #B6BCB5;
  --c-line: rgba(32, 36, 33, 0.08);
  --c-safe: #3E8F72;
  --c-warn: #D79A27;
  --c-danger: #C65B55;
  --c-safe-bg: rgba(62, 143, 114, 0.10);
  --c-warn-bg: rgba(215, 154, 39, 0.12);
  --c-danger-bg: rgba(198, 91, 85, 0.10);
  --c-hover: rgba(32, 36, 33, 0.04);
  --c-shadow: 0 8rpx 28rpx rgba(32, 36, 33, 0.06);
  /* 备忘状态（M1 备忘模式）：莫兰迪浅蓝，独立于红黄绿到期语义 */
  --c-memo: #7C93A8;
  --c-memo-bg: rgba(124, 147, 168, 0.12);
  min-height: 100vh;
  background: var(--c-bg);
  color: var(--c-text);
  box-sizing: border-box;
}

.page-root.theme-dark {
  --c-bg: #141619;
  --c-card: #1E2125;
  --c-card-2: #262A2F;
  --c-text: #E8EAE6;
  --c-sub: #98A09A;
  --c-faint: #6C736E;
  --c-line: rgba(255, 255, 255, 0.08);
  --c-safe: #66BD9C;
  --c-warn: #E3B45C;
  --c-danger: #E08A82;
  --c-safe-bg: rgba(102, 189, 156, 0.14);
  --c-warn-bg: rgba(227, 180, 92, 0.14);
  --c-danger-bg: rgba(224, 138, 130, 0.14);
  --c-hover: rgba(255, 255, 255, 0.06);
  --c-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
  --c-memo: #A9C0D4;
  --c-memo-bg: rgba(169, 192, 212, 0.16);
}

/* ====== 通用按钮（使用 view + hover-class，避免原生 button 默认样式） ====== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 0 40rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  box-sizing: border-box;
}
.btn-hover { opacity: 0.85; transform: translateY(1rpx); }
.btn-primary { background: var(--c-text); color: var(--c-bg); }
.btn-plain { background: var(--c-card-2); color: var(--c-text); border: 1rpx solid var(--c-line); }
.btn-safe { background: var(--c-safe); color: #FFFFFF; }
.btn-danger { background: var(--c-danger); color: #FFFFFF; }
.btn-danger-ghost { background: var(--c-danger-bg); color: var(--c-danger); }
.btn-disabled { opacity: 0.45; }

/* ====== 页面级纵向滚动容器 ======
 * 配合各页面 json 中的 "disableScroll": true 使用：
 * 锁死页面原生滚动，彻底避免 iOS WebView 整体可上下左右拖拽、
 * 内容偏移与双向滚动条问题；纵向滚动完全由 scroll-view 承担。 */
.page-scroll {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  /* 刻意不在这里挂任何入场动画：.page-scroll 是整页 100vh 的滚动容器，
   * 对它做 opacity / transform 动画会牵动整页重绘；而 tab 页实例常驻、节点不重建，
   * 要让它重播就得在每次 onShow 换 animation-name，结果就是「每次切 Tab 整页闪一下」
   * 的二次刷新感。navigateTo 的页面自带系统转场，也不需要再叠一层。 */
}

/* ====== 自定义下拉刷新区域（scroll-view slot="refresher"）======
 * 三页（首页 / 今天 / 物品）refresher-default-style="none" 后由本区域承担下拉反馈。
 * slot 节点必须有明确高度，否则微信不渲染；文案随下拉状态切换：
 * 下拉刷新 → 松开立即刷新 → 正在刷新…（由各页 onRefresherPulling / onScrollRefresh 驱动）。 */
.rf {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rf-dot {
  width: 26rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  border: 3rpx solid var(--c-faint);
  border-top-color: var(--c-sub);
  box-sizing: border-box;
}
.rf-loading { animation: rf-spin 0.7s linear infinite; }
@keyframes rf-spin { to { transform: rotate(360deg); } }
.rf-text { font-size: 24rpx; color: var(--c-sub); }

/* ====== 通用卡片与分区 ====== */
.card {
  background: var(--c-card);
  border-radius: 24rpx;
  border: 1rpx solid var(--c-line);
  box-shadow: var(--c-shadow);
}
.card-hover { opacity: 0.92; transform: translateY(1rpx); }
.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 40rpx 40rpx 20rpx;
}
.section-title .t { font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx; }
.section-title .s { font-size: 24rpx; color: var(--c-faint); }

/* ====== 表单 ====== */
.field { padding: 24rpx 32rpx; }
.field-label { font-size: 26rpx; color: var(--c-sub); margin-bottom: 14rpx; }
.field-label .req { color: var(--c-danger); margin-right: 4rpx; }
.input-base {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--c-card-2);
  border: 1rpx solid var(--c-line);
  border-radius: 18rpx;
  font-size: 30rpx;
  color: var(--c-text);
}
.ph-text { color: var(--c-faint); }
.err-text { margin-top: 10rpx; font-size: 24rpx; color: var(--c-danger); }
.hint-text { margin-top: 10rpx; font-size: 24rpx; color: var(--c-safe); }

/* ====== 通用 chip（筛选胶囊） ====== */
.chip {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  color: var(--c-sub);
  font-size: 26rpx;
  white-space: nowrap;
}
.chip-on {
  background: var(--c-text);
  border-color: var(--c-text);
  color: var(--c-bg);
  font-weight: 500;
}
.chip-count { margin-left: 8rpx; font-size: 22rpx; opacity: 0.7; }

/* ====== 语义状态文字色 ====== */
.lv-text-expired { color: var(--c-danger); }
.lv-text-warning { color: var(--c-warn); }
.lv-text-safe { color: var(--c-safe); }
.lv-text-memo { color: var(--c-memo); }
.lv-text-warranty { color: var(--c-memo); }

/* ====== 列表行 ====== */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
}
.cell + .cell { border-top: 1rpx solid var(--c-line); }
.cell-title { font-size: 29rpx; }
.cell-sub { font-size: 23rpx; color: var(--c-faint); margin-top: 4rpx; }
.cell-value { font-size: 27rpx; color: var(--c-sub); display: flex; align-items: center; }

/* ====== 进度条 ====== */
.bar { height: 8rpx; border-radius: 999rpx; background: var(--c-card-2); overflow: hidden; }
.bar-inner { height: 100%; border-radius: 999rpx; }
.bar-inner.lv-expired, .lv-bar-expired { background: var(--c-danger); }
.bar-inner.lv-warning, .lv-bar-warning { background: var(--c-warn); }
.bar-inner.lv-safe, .lv-bar-safe { background: var(--c-safe); }
.bar-inner.lv-memo, .lv-bar-memo { background: var(--c-memo); }
.bar-inner.lv-warranty, .lv-bar-warranty { background: var(--c-memo); }

/* ====== 自定义复选框 ====== */
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid var(--c-faint);
  box-sizing: border-box;
  position: relative;
  flex-shrink: 0;
}
.checkbox.on { background: var(--c-safe); border-color: var(--c-safe); }
.checkbox.on .tick {
  position: absolute;
  left: 12rpx;
  top: 5rpx;
  width: 12rpx;
  height: 22rpx;
  border-right: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: rotate(45deg);
}
.checkbox.disabled { opacity: 0.35; }
